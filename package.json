{
  "name": "wanikani-api-types",
  "private": true,
  "homepage": "https://wanikani-api-types.bachman.dev",
  "license": "MIT",
  "author": "Collin Bachman <collin.r68zdn9d@bachman.dev>",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "format": "oxfmt --config oxfmt.config.ts --write .",
    "format:check": "oxfmt --config oxfmt.config.ts --check .",
    "lint": "oxlint --config oxlint.config.ts .",
    "lint:fix": "oxlint --config oxlint.config.ts --fix .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@bachman-dev/oxc-config": "0.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "publint": "0.3.25",
    "tsdown": "0.23.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  }
}
